# Copy to .env and fill in. Never commit the real .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=immersio
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/immersio

YOUTUBE_API_BASE_URL=
YOUTUBE_API_KEY=
# Residential proxy for yt-dlp (captions/audio) — YouTube blocks datacenter IPs.
# e.g. http://user:pass@host:port. Leave empty locally.
YOUTUBE_PROXY=
# Or/and: path to a Netscape-format cookies.txt from a throwaway YouTube account.
# Must be writable (yt-dlp saves refreshed cookies back). Never commit it.
YOUTUBE_COOKIES=

GEMINI_API_KEY=

SECURITY_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# Deployment
# Comma-separated frontend origins allowed by CORS (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://www.immersio.tech
# 1 = load Whisper + compile pyin at startup so the first score is fast.
WHISPER_PRELOAD=0
